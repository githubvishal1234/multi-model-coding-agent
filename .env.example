# Ferrule reads FERRULE_* environment variables (it does not load this file itself).
# Every setting is optional; defaults are shown. Never put real keys in this file.

# FERRULE_BASE_URL=http://127.0.0.1:11434/v1
# FERRULE_MODEL=qwen2.5-coder:7b
# FERRULE_SUPPORTS_TOOLS=true          # false = prompted JSON tool calls (e.g. deepseek-coder)
# FERRULE_HOME=~/.ferrule              # audit log and undo checkpoints
# FERRULE_MAX_STEPS=20
# FERRULE_MAX_INVALID=3                # consecutive invalid tool calls before stopping
# FERRULE_MODEL_TIMEOUT=300            # seconds per model call
# FERRULE_COMMAND_TIMEOUT=120          # seconds per command
# FERRULE_APPROVAL=ask                 # ask | auto_safe (auto-approves run_tests and git status/diff/log/show)
# FERRULE_TEST_COMMAND=["python", "-m", "pytest", "-q"]
# FERRULE_ALLOWLIST={"pytest": null, "git": ["status", "diff", "log", "show"]}
