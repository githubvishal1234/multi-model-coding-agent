# Ferrule reads environment variables (it does not load this file itself).
# Every setting is optional; defaults are shown. Never put real keys in this file.

# --- model choice ---
# FERRULE_MODEL=                       # unset = the router chooses; set e.g. qwen2.5-coder:7b to fix one Ollama model
# FERRULE_PROFILE=balanced             # fast | balanced (local first, then hosted) | quality (strongest first)
# FERRULE_LOCAL_ONLY=false             # true = never send code or prompts to hosted providers
# FERRULE_MAX_HOSTED_REQUESTS=50       # cap on hosted requests per run
# FERRULE_MIN_TOKENS_PER_SEC=4.0       # local models measured slower than this are skipped (starting guess)
# FERRULE_REGISTRY=                    # path to a models.yaml; default is the one shipped in ferrule/

# --- free hosted providers (optional) ---
# Each is used only when its key is set. Get keys from the providers' own sites, check their
# current free-tier limits and data-use terms, then run `ferrule doctor` to see which model
# ids they serve. Free tiers may use your prompts for training: keep private code local.
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- agent ---
# FERRULE_BASE_URL=http://127.0.0.1:11434/v1
# FERRULE_SUPPORTS_TOOLS=true          # false = prompted JSON tool calls (e.g. deepseek-coder)
# FERRULE_HOME=~/.ferrule              # audit log, undo checkpoints, measured model speeds
# FERRULE_MAX_STEPS=20
# FERRULE_MAX_INVALID=3                # consecutive invalid tool calls before escalating or stopping
# FERRULE_MAX_TOKENS=4096              # cap per model reply
# FERRULE_MODEL_TIMEOUT=300            # seconds per model call
# FERRULE_COMMAND_TIMEOUT=120          # seconds per command
# FERRULE_APPROVAL=ask                 # ask | auto_safe (auto-approves run_tests and git status/diff/log/show)
# FERRULE_TEST_COMMAND=["python", "-m", "pytest", "-q"]
# FERRULE_ALLOWLIST={"pytest": null, "git": ["status", "diff", "log", "show"]}
